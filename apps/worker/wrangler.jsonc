// ReelChords edge worker: API routes + static PWA hosting on one origin.
//
// Serving both from one Worker avoids CORS entirely — the app calls
// /api/* relative to itself. Deploy (after building the PWA):
//   npx wrangler deploy --config apps/worker/wrangler.jsonc
//
// Production configuration:
//   wrangler secret put RESOLVER_API_KEY   (RapidAPI key)
//   wrangler secret put SIGNING_KEY        (any long random string)
//   vars RESOLVER_HOST / RESOLVER_PATH below or in the dashboard.
{
  "name": "reelchords",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../pwa/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // API must always reach the script, never the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Third-party Instagram resolver (RapidAPI-style: GET ?url=<reel>).
    // Providers churn; swapping providers should only mean changing these
    // two values plus the secret — never code.
    "RESOLVER_HOST": "instagram-reels-downloader-api.p.rapidapi.com",
    "RESOLVER_PATH": "/download"
  }

  // OPTIONAL: rate-limit counters + resolved-URL cache.
  // Without this binding the limiter still runs, but per-isolate and
  // in-memory — a floor rather than a guarantee — and resolve results are
  // not cached, so repeats spend provider quota again. To enable:
  //   npx wrangler kv namespace create RATE_LIMIT_KV
  // then uncomment, filling in the id it prints:
  //
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "<id-from-the-command-above>" }
  // ]
}
