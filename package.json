{
  "name": "reelchords",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a guitar-tutorial reel into a saved ChordPro chord + lyric sheet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:pwa": "npm run dev --workspace apps/pwa"
  }
}
